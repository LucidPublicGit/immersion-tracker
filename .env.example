# setup.ps1 / setup.sh replace "changeme" with a random secret automatically.
WEBHOOK_SECRET=changeme
# Optional UI gate (HTTP Basic). Empty = open (LAN/dev). Set before exposing :8000.
# UI_USERNAME=admin
# UI_PASSWORD=
# Optional: paste full service account JSON as a single line
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Logged-in tadoku.app Cookie header (for live submit). Expires — refresh via
# queue UI paste or POST /api/tadoku/session (writes data/tadoku_session.cookie).
# TADOKU_COOKIE=ory_kratos_session=...; other_cookies=...
DATABASE_URL=sqlite:////app/data/immersion.db
CONFIG_PATH=config/settings.yaml

# --- Integration secrets (never commit real values; .env is gitignored) ---
# Steam Web API: https://steamcommunity.com/dev/apikey  (domain: localhost)
STEAM_API_KEY=
STEAM_ID=
# Spotify: https://developer.spotify.com/dashboard + scripts/spotify_oauth_setup.py
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Audiobookshelf user API token (Settings → Users → API token)
# AUDIOBOOKSHELF_URL=http://host.docker.internal:13378
AUDIOBOOKSHELF_TOKEN=
# Optional: mpv lua script reads this instead of writing secret into conf files
# IMMERSION_WEBHOOK_SECRET=

# Host binds for docker-compose (Windows GSM / mpv history)
GSM_DATA_DIR=
MPV_DATA_DIR=
